// Oaken Market — schema da base de dados
// MVP: só a Oaken vende. O modelo já separa "Seller" de "Course" para que,
// mais tarde, abrir a plataforma a outros criadores seja adicionar linhas
// a Seller e ligar user->seller, sem mexer no resto do schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CourseType {
  DIGITAL
  PHYSICAL
  SERVICE
  PAYMENT
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(BUYER)
  createdAt    DateTime @default(now())

  // 2FA (TOTP). twoFactorSecret só é preenchido depois de o utilizador
  // confirmar um código válido (ver POST /api/auth/2fa/verify) — nunca
  // fica activo só por ter gerado um QR code. twoFactorTempSecret guarda
  // o segredo enquanto a configuração está pendente de confirmação.
  twoFactorEnabled    Boolean @default(false)
  twoFactorSecret     String?
  twoFactorTempSecret String?

  orders       Order[]
  enrollments  Enrollment[]
  affiliations Affiliate[]
}

model Seller {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  courses   Course[]
  webhooks  WebhookEndpoint[]
}

model Course {
  id          String   @id @default(uuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id])
  slug        String   @unique
  title       String
  description String
  priceKz     Int
  coverUrl    String?
  category    String?
  type        CourseType @default(DIGITAL)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  modules      Module[]
  orders       Order[]
  enrollments  Enrollment[]
  affiliates   Affiliate[]
}

model Module {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  order    Int
  title    String

  lessons  Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id          String  @id @default(uuid())
  moduleId    String
  module      Module  @relation(fields: [moduleId], references: [id])
  order       Int
  title       String
  contentHtml String
  durationMin Int     @default(50)

  @@unique([moduleId, order])
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  courseId    String
  course      Course      @relation(fields: [courseId], references: [id])
  amountKz    Int
  status      OrderStatus @default(PENDING)
  provider    String
  providerRef String?
  createdAt   DateTime    @default(now())
  paidAt      DateTime?

  // UTM capturados na página do curso no momento da compra (opcional) —
  // permitem ver de que campanha veio cada venda.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  // Indicação (opcional) — preenchida se a compra veio de um link de
  // afiliado aprovado. commissionKz é só informativo (o que o afiliado
  // teria a receber) — não existe saque de comissão enquanto não houver
  // pagamento real, mesma regra do saldo em Financeiro.
  affiliateId   String?
  affiliate     Affiliate? @relation(fields: [affiliateId], references: [id])
  commissionKz  Int?

  enrollment  Enrollment?

  @@unique([provider, providerRef])
}

model Affiliate {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  courseId      String
  course        Course          @relation(fields: [courseId], references: [id])
  status        AffiliateStatus @default(PENDING)
  commissionPct Int             @default(30)
  createdAt     DateTime        @default(now())
  decidedAt     DateTime?

  orders        Order[]

  @@unique([userId, courseId])
}

// Webhook de saída — o painel de produtor regista um URL, o backend
// chama-o (POST, assinado com HMAC do secret) quando uma encomenda fica
// PAID. Pensado para o dono ligar isto a automações próprias (ex: n8n).
model WebhookEndpoint {
  id        String   @id @default(uuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id])
  url       String
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}
